# Backend API Base URL
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api
# Vercel Production Environment Variable (Render Backend URL):
# VITE_API_BASE_URL=https://your-django-service.onrender.com/api

# Public Hotel Website URL (Used for "Public Website" back-links)
# Local development:
VITE_PUBLIC_WEBSITE_URL=http://localhost:3000
# Vercel Production Environment Variable:
# VITE_PUBLIC_WEBSITE_URL=https://hotel-lara-international.vercel.app
