# ==============================================================
# Hotel Lara International - Django Backend Environment Config
# ==============================================================

# Security
DJANGO_SECRET_KEY=hotel-lara-insecure-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for Production, SQLite fallback for local dev)
# Example PostgreSQL production connection:
# DATABASE_URL=postgresql://hotel_lara_user:password@localhost:5432/hotel_lara_db
# DB_NAME=hotel_lara_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS (Frontend origins: add your deployed Vercel domains)
# e.g.: CORS_ALLOWED_ORIGINS=https://hotel-lara-international.vercel.app,https://hotel-lara-booking-dashboard.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Automatically permit Vercel preview URLs matching *.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS=True

# Optional: set True during initial setup if encountering cross-origin issues
# CORS_ALLOW_ALL_ORIGINS=False
