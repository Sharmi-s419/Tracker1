# ==============================================================
# Hotel Lara International - Django Backend Environment Config
# ==============================================================

# Security
DJANGO_SECRET_KEY=hotel-lara-insecure-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for Production, SQLite fallback for local dev)
# Example PostgreSQL production connection:
# DATABASE_URL=postgresql://hotel_lara_user:password@localhost:5432/hotel_lara_db
# DB_NAME=hotel_lara_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS (Frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
